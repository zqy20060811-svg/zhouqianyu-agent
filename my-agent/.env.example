# ---- LLM 提供方 (OpenAI 兼容) ----
# 非 localhost 必须 https
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=replace_me
MODEL_NAME=gpt-4o-mini
MODEL_TIMEOUT_MS=45000

# ---- 服务端口 ----
PORT=8787
# 反向代理后置为 1
TRUST_PROXY=0

# ---- Streamlit 前端 ----
STREAMLIT_PORT=8501
FASTAPI_BASE_URL=http://127.0.0.1:8787

# ---- LangSmith 追踪 (可选,留空则关闭) ----
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zhouqianyu-agent

# ---- 限流 ----
CHAT_LIMIT=20
CHAT_WINDOW_MS=600000
